{
  "manifest_version": 3,
  "name": "Budget: Bankumsätze",
  "version": "0.2.0",
  "description": "Meldet sich auf Zuruf bei Trade Republic, der GLS Bank oder der TF Bank (Kreditkarte) an, liest die Umsätze und schickt sie an die Budget-App.",
  "action": { "default_title": "Budget: Bankumsätze" },
  "background": { "service_worker": "hintergrund.js" },
  "permissions": ["scripting", "storage", "tabs", "cookies"],
  "host_permissions": [
    "https://app.traderepublic.com/*",
    "https://www.gls-online-filiale.de/*",
    "https://meine.tfbank.de/*",
    "https://*.tfbank.se/*",
    "http://10.168.178.20:8123/*",
    "http://192.168.178.20:8123/*"
  ],
  "content_scripts": [
    { "matches": ["https://app.traderepublic.com/*"], "js": ["tr-haken.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://www.gls-online-filiale.de/*", "https://meine.tfbank.de/*"], "js": ["json-haken.js"], "run_at": "document_start", "world": "MAIN" }
  ]
}
